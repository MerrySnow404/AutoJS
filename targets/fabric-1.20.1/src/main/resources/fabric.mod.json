{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["cc.sighs.autojs.neoforge.AutoJSFabric"],
    "client": ["cc.sighs.autojs.neoforge.AutoJSFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=17",
    "rhino": "${rhino_version_range}"
  },
  "suggests": {
    "kubejs": "*"
  }
}
